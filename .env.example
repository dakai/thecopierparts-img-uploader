# Cloudflare R2 Configuration
CF_ACCESS_KEY=your_access_key_here
CF_SECRET_KEY=your_secret_key_here
CF_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Buckets
PUBLIC_BUCKET=your_public_bucket
PRIVATE_BUCKET=your_private_bucket

# Backup sync (download_backups.sh)
BACKUP_API_URL=https://your_api_host
BACKUP_BUCKET=your_backup_bucket
BACKUP_PREFIX=your/backup/prefix/

# App Security
SECRET_KEY=your_app_secret_key
ALLOW_HOSTS=*
